# ==============================================================================
# BORROWME ENVIRONMENT CONFIGURATION
# ==============================================================================
# Hướng dẫn: Sao chép file này thành .env trên local hoặc cấu hình trong mục:
# Project Settings > Environment Variables trên Vercel Dashboard
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION
# ------------------------------------------------------------------------------
# Lưu ý quan trọng khi deploy lên Vercel:
# - SQLite KHÔNG dùng được trên production Vercel vì serverless function là read-only.
# - Dùng PostgreSQL (Khuyên dùng: Supabase, Neon hoặc Vercel Postgres - đều có bản miễn phí).
#
# Ví dụ cho Supabase / Neon (Production):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
#
# Mặc định local SQLite (Chỉ dùng chạy thử máy cá nhân):
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Khóa bí mật dùng để mã hóa và ký JWT Session token (Tối thiểu 32 ký tự ngẫu nhiên)
# Tạo nhanh bằng lệnh: openssl rand -base64 32
JWT_SECRET="borrowme-super-secret-production-key-change-me-2026"

# ------------------------------------------------------------------------------
# 3. PRODUCTION DOMAIN
# ------------------------------------------------------------------------------
# Domain chính thức của ứng dụng (Dùng cho VietQR, webhooks, metadata chia sẻ)
NEXT_PUBLIC_APP_URL="https://borrowme.vercel.app"

# ------------------------------------------------------------------------------
# 4. CRON JOBS SECURITY (Vercel Cron)
# ------------------------------------------------------------------------------
# Khóa bảo mật để Vercel Cron kích hoạt endpoint /api/cron/reminders
# Ngăn chặn truy cập trái phép từ bên ngoài
CRON_SECRET="borrowme-cron-secret-key-2026"

# ------------------------------------------------------------------------------
# 5. VIETQR DEFAULT CONFIGURATION (Tùy chọn)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VIETQR_BANK_ID="MB"
NEXT_PUBLIC_VIETQR_ACCOUNT_NO="090123456789"
NEXT_PUBLIC_VIETQR_ACCOUNT_NAME="BORROWME ESCROW SYSTEM"
